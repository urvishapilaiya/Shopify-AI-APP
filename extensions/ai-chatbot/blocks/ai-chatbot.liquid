<div
  id="ai-chatbot-root"
  data-shop-domain="{{ shop.permanent_domain }}"
  data-order-api="{{ block.settings.api_url | escape }}"
></div>

{% schema %}
{
  "name": "AI Chatbot",
  "target": "body",
  "javascript": "chatbot.js",
  "stylesheet": "chatbot.css",
  "settings": [
    {
      "type": "text",
      "id": "api_url",
      "label": "Order tracking backend URL",
      "placeholder": "https://your-backend.onrender.com",
      "info": "Same backend URL used by the Order Tracking page"
    }
  ]
}
{% endschema %}
